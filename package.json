{
  "name": "pi-pe",
  "version": "0.1.0",
  "description": "Declarative, validated linear pipelines for pi-protocol capabilities",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-protocol",
    "pipelines",
    "orchestration"
  ],
  "license": "AGPL-3.0",
  "exports": {
    ".": "./extension.ts",
    "./runtime": "./src/index.ts"
  },
  "files": [
    "extension.ts",
    "pi.protocol.json",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --import tsx --test test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./extension.ts"
    ]
  },
  "dependencies": {
    "@kybernetria/pi-protocol": "^1.0.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
